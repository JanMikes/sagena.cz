# Frontend environment variables
# Copy to .env.local for local development (without Docker).
# In Docker/production these are injected via compose; see compose.override.yaml
# (local) and ~/www/spare.srv/deployment/sagena/docker-compose.yml (production).

# --- Public site URL -------------------------------------------------------
# Absolute origin used for canonical/hreflang metadata, robots.txt and
# sitemap.xml. Server-side only (no NEXT_PUBLIC_ prefix). Defaults to
# https://sagena.cz in code, so it is optional in production but should be set
# explicitly. No trailing slash.
SITE_URL=http://localhost:3000

# --- Strapi connection -----------------------------------------------------
# Server-side URL (SSR / build). In Docker use the service name: http://strapi:1337
STRAPI_URL=http://localhost:1337
# Client-side URL exposed to the browser. In production this is the public admin host.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Strapi REST API token (server-side only — never expose to the browser)
STRAPI_API_TOKEN=
# Shared secret for Strapi -> Next.js cache-invalidation webhook
STRAPI_WEBHOOK_SECRET=
# Strapi JWT secret (intranet auth)
STRAPI_JWT_SECRET=

# --- Media / cache ---------------------------------------------------------
# Public base URL for uploaded media (served via nginx/CDN)
PUBLIC_UPLOADS_URL=http://localhost:8080
# Redis connection for the server-side cache
REDIS_URL=redis://redis:6379

# --- Intranet --------------------------------------------------------------
# Shared secret required for intranet signup (server-side only)
SIGNUP_SECRET=

# --- Email (intranet notifications) ----------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=ssl
EMAIL_FROM=noreply@sagena.cz
EMAIL_RECIPIENTS=

# --- Error monitoring (optional) -------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
